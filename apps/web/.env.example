# Copy to .env.local (git-ignored) and fill in. These are PUBLIC identifiers for a SPA (no secrets).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Identifier of the Auth0 API that the Worker validates tokens for (must match AUTH0_AUDIENCE on the API)
VITE_AUTH0_AUDIENCE=https://church-accounting/api
