{
  "name": "church-accounting",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev:local",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "dev:setup": "scripts/dev-setup.sh",
    "dev": "bun run scripts/dev.ts",
    "dev:db:reset": "docker compose down -v && scripts/dev-setup.sh",
    "smoke": "bun run scripts/smoke.ts",
    "dev:auth0": "bun run scripts/dev.ts --auth0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
